# ==========================================
# MarginPilot AI - Environment Configuration
# ==========================================

# 1. Google Gemini AI API Key (Free tier from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PayPal Sandbox Developer Credentials (developer.paypal.com)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_MODE=sandbox

# 3. Channel3 Product Catalog Key (trychannel3.com/developers)
CHANNEL3_API_KEY=your_channel3_api_key_here
